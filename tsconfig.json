{
  "extends": "./node_modules/plasmo/templates/tsconfig.base.json",
  "exclude": ["node_modules"],
  "include": [".plasmo/index.d.ts", "./**/*.ts", "./**/*.tsx"],
  "compilerOptions": {
    "moduleResolution": "bundler",
    "paths": {
      "~components/*": ["./src/components/*"],
      "~hooks/*": ["./src/hooks/*"],
      "~lib/*": ["./lib/*"],
      "~core/*": ["./src/core/*"],
      "~features/*": ["./src/features/*"],
      "~shared/*": ["./src/shared/*"],
      "~styles/*": ["./styles/*"],
      "~src/*": ["./src/*"],
      "~*": ["./*"]
    },
    "baseUrl": "."
  }
}
